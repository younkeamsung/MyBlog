@inject ICategoryRepository _Category_repository
@inject NavigationManager NavigationManager


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">My Blog Wep</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/blogposts">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Admin
            </NavLink>
        </div>
        <div class="nav-item px-3 dropdown">
            <button class="nav-link btn btn-outline-light" @onclick="ToggleCategory">
                카테고리 <span class="ms-1">▼</span>
            </button>
            @if (categories.Count > 0)
            {
                    @if (showCategories)
                    {
                        <ul class="dropdown-menu show">
                            @foreach (var c in categories)
                            {
                                <li class="d-flex align-items-center">
                                    <a class="dropdown-item" href="/categories/@c.CategoryId">@c.Name</a>
                                    <button type="button" class="btn btn-sm text-danger me-2"
                                    @onclick="() => OpenDeleteCategoryModal(c.CategoryId, c.Name)">X</button>
                                </li>
                            }
                        </ul>
                    }
            }
        </div>

        
        <div class="nav-item px-3">
            <NavLink class="nav-link btn btn-outline-light" @onclick="OpenCategoryCreateModal">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>카테고리 생성
            </NavLink>
        </div>
    </nav>
</div>

@if (DeleteCategoryModalOpen)
{
    <div class="modal show" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@CategoryName 삭제</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="CloseDeleteCategoryModal"></button>
                </div>
                <div class="modal-body">
                    <p>정말로 "@CategoryName" 카테고리를 삭제하시겠습니까?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" @onclick="() => ConfirmDeleteCategory(CategoryId)">삭제</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseDeleteCategoryModal">닫기</button>
                </div>
            </div>
        </div>
    </div>
}


@if (CategoryCreateModalOpen)
{
    <div class="modal show" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true" style="display: block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">카테고리생성</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="CloseCategoryModal"></button>
                </div>
                <div class="modal-body">
                    <input type="text" id="inputPassword5" class="form-control" placeholder="카테고리 이름" @bind="newCategoryName" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="() => AddCategory(newCategoryName)">추가</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseCategoryModal">닫기</button>
                </div>
            </div>
        </div>
    </div>
}





@code{
    // 카테고리 데이터 리스트
    private List<Category?> categories = new();

    // 카테고리 생성 모달에서 받아온 텍스트 변수
    private string newCategoryName = string.Empty;
    // 카테고리 삭제 모달 head에 집어넣을 카테고리 이름 변수
    private string CategoryName = string.Empty;
    // 카테고리 삭제 모달에 매개변수로 사용되는 카테고리 아이디 변수
    private string CategoryId = string.Empty;

    // 카테고리 생성 모달 상태값
    private bool CategoryCreateModalOpen = false;
    // 카테고리 드롭다운 상태값
    private bool showCategories = false;
    // 카테고리 삭제 모달 상태값
    private bool DeleteCategoryModalOpen = false;


    // 카테고리 생성 제한 경고창 콜백
    [Parameter]
    public EventCallback OnCategoryLimit { get; set; }

    // 최초 실행시 페이지 로드
    protected override async Task OnInitializedAsync()
    {
        await LoadPostsAsync();
    }

    // 페이지 로드
    private async Task LoadPostsAsync()
    {
        categories = await _Category_repository.GetCategorysAsync()
         ?? new List<Category>();
    }
    
    // 카테고리 드롭다운 열기
    private void ToggleCategory()
    {
        showCategories = !showCategories;
    }
    
    // 카테고리 드롭다운 닫기
    private void CloseCategoryDropdown()
    {
        showCategories = false;
    }
    
    // 카테고리생성 제한 후 MainLayout으로 상태값 보냄
    private async Task OpenCategoryCreateModal()
    {
        if(categories != null && categories.Count < 5)
        {
            CategoryCreateModalOpen = true;
        }
        else
        {
            await OnCategoryLimit.InvokeAsync();
        }
    }
    
    // 카테고리 생성 모달 닫기
    private void CloseCategoryModal()
    {
        CategoryCreateModalOpen = false;
        newCategoryName = "";
    }

    // 카테고리 삭제 확인 모달
    private async Task OpenDeleteCategoryModal(string id, string name)
    {
        CategoryId = id;
        CategoryName = name;
        DeleteCategoryModalOpen = true;
    }
    
    // 카테고리 삭제
    private async Task ConfirmDeleteCategory(string id)
    {
        await _Category_repository.DeleteCategoryAsync(id);
        categories = await _Category_repository.GetCategorysAsync();
        CloseDeleteCategoryModal();
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
    
    // 카테고리 삭제 모달 닫기
    private void CloseDeleteCategoryModal()
    {
        DeleteCategoryModalOpen = false;
    }

    // 카테고리 생성
    private async Task AddCategory(string Name)
    {
        await _Category_repository.SaveCategoryAsync(Name);
        categories = await _Category_repository.GetCategorysAsync();
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        newCategoryName = "";
        CloseCategoryModal();
    }

}

