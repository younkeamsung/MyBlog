@page "/admin/blogposts/new"
@page "/admin/blogposts/{Id}"
@inject IBlogRepository _repository
@inject ICategoryRepository category_repository
@inject NavigationManager _manager
@rendermode InteractiveServer


<div class="container-md">
    <div class="row">
        <div class="col-12 col-md-6 mx-auto">
            <h3 class="mb-4">BlogPostEdit</h3>

            <EditForm Model="Post" FormName="BlogPostForm" OnValidSubmit="SavePost">
                <DataAnnotationsValidator />
                <div>
                    <label for="postTitle" class="form-label">제목</label>
                    <InputText id="postTitle" class="form-control" @bind-Value="Post.Title" placeholder="제목을 입력하세요"/>
                    <div class="text-danger small mt-1">
                        <ValidationMessage For="() => Post.Title" />
                    </div>
                </div>
                <div>
                    <label for="postCategory" class="form-label">카테고리</label>
                    <InputSelect id="postCategory" class="form-control" @bind-Value="Post.CategoryId">
                        <option value="">카테고리를 선택하세요</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.CategoryId">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="mt-2">
                    <label for="postDate" class="form-label">작성일</label>
                    <InputDate id="postDate" class="form-control" @bind-Value="Post.PublishDate" />
                    <div class="text-danger small mt-1">
                        <ValidationMessage For="() => Post.PublishDate" />
                    </div>
                </div>
                <div class="mt-2">
                    <label for="postText" class="form-label">내용</label>
                    <InputTextArea id="postText" class="form-control" rows="5" @bind-Value="Post.Text" placeholder="내용을 입력하세요"/>
                    <div class="text-danger small mt-1">
                        <ValidationMessage For="() => Post.Text" />
                    </div>
                </div>
                <div class="d-flex justify-content-center mt-3">
                    <button type="submit" class="btn btn-success me-1 shadow-sm">저장</button>
                    <button type="button" class="btn btn-secondary shadow-sm" @onclick="GoToBlogPosts">취소</button>
                </div>

            </EditForm>
        </div>
    </div>
</div>

@code {
    BlogPost Post { get; set; } = new();
    [Parameter]
    public string? Id { get; set; }
    private List<Category?> categories = new();
    

    protected override async Task OnInitializedAsync()
    {
        categories = await category_repository.GetCategorysAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        
        if(Id != null)
        {
            var p = await _repository.GetBlogPostAsync(Id);
            if(p != null)
            {
                Post = p;
            }
        }
    }

    public async Task SavePost()
    {
        await _repository.SaveBlogPostAsync(Post);
        _manager.NavigateTo("/admin/blogposts");
    }

    private void GoToBlogPosts()
    {
        _manager.NavigateTo("/admin/blogposts", true);
    }
}
